{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wellmanifest.dev/schemas/logs/urtlog-bridge-profile.v1.json",
  "title": "wellmanifest/logs Opt-in URTLog Bridge and Decision-Slicing Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "version",
    "placement",
    "packaging",
    "temporalModel",
    "registry",
    "decisionContextSlice",
    "verification"
  ],
  "properties": {
    "$schema": {
      "const": "./urtlog-bridge.schema.v1.json"
    },
    "schema": {
      "const": "wellmanifest.logs/urtlog-bridge-profile/v1"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["home", "shape", "runtimeImplementations", "adopt"],
      "properties": {
        "home": { "const": "wellmanifest" },
        "shape": { "const": "domain_pack" },
        "runtimeImplementations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"
          }
        },
        "adopt": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^wellmanifest/[a-z0-9-]+$"
          }
        }
      }
    },
    "packaging": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extraName",
        "requirement",
        "mandatoryRuntimeDependency",
        "lazyImportModule",
        "optInEnvVar",
        "failOpenOnMissingOrError",
        "mutateTrackedRepoFiles"
      ],
      "properties": {
        "extraName": { "const": "urtlog" },
        "requirement": {
          "type": "string",
          "pattern": "^uritime-urtlog>=[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "mandatoryRuntimeDependency": { "const": false },
        "lazyImportModule": { "const": "urtlog" },
        "optInEnvVar": { "const": "URTLOG_STATE_DIR" },
        "failOpenOnMissingOrError": { "const": true },
        "mutateTrackedRepoFiles": { "const": false }
      }
    },
    "temporalModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tuple",
        "planKind",
        "logKind",
        "planNeverSucceeded",
        "planGrantsAuthority",
        "allowedEventStatuses",
        "blockedStateMapping",
        "dagLinkFields"
      ],
      "properties": {
        "tuple": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            { "const": "URT" },
            { "const": "URI" },
            { "const": "URN_IN" },
            { "const": "URN_OUT" }
          ],
          "items": false
        },
        "planKind": { "const": "intent" },
        "logKind": { "const": "event" },
        "planNeverSucceeded": { "const": true },
        "planGrantsAuthority": { "const": false },
        "allowedEventStatuses": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "planned",
              "started",
              "succeeded",
              "failed",
              "unknown",
              "canceled"
            ]
          }
        },
        "blockedStateMapping": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "eventStatus",
            "logType",
            "metadataStatusField",
            "metadataStatusValue"
          ],
          "properties": {
            "eventStatus": { "const": "unknown" },
            "logType": { "const": "audit" },
            "metadataStatusField": { "const": "status" },
            "metadataStatusValue": { "const": "blocked" }
          }
        },
        "dagLinkFields": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": ["causation_id", "depends_on", "input_urns", "output_urns"]
          }
        }
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supportedKinds",
        "secretsInUrlsOrFixtures",
        "accessContextFailClosed",
        "payloadStorage"
      ],
      "properties": {
        "supportedKinds": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": ["uri", "url", "urn"]
          }
        },
        "secretsInUrlsOrFixtures": { "const": false },
        "accessContextFailClosed": { "const": true },
        "payloadStorage": { "const": "urn-vault-separated" }
      }
    },
    "decisionContextSlice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetRole",
        "maxSliceBytes",
        "lookupMode",
        "singleUrnIsolationForEntityQueries",
        "forbidUnfilteredDump",
        "grantsExecutionAuthority"
      ],
      "properties": {
        "targetRole": { "const": "decision" },
        "maxSliceBytes": {
          "type": "integer",
          "minimum": 128,
          "maximum": 1024
        },
        "lookupMode": {
          "enum": ["btree-prefix-or-single-urn", "single-urn"]
        },
        "singleUrnIsolationForEntityQueries": { "const": true },
        "forbidUnfilteredDump": { "const": true },
        "grantsExecutionAuthority": { "const": false }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requireOfflineFailOpenTests",
        "requireLiveIntegrationTests",
        "forbidPytestMarkSkip",
        "optionalDependencyGuard",
        "forbidSecretLikeTestLiterals"
      ],
      "properties": {
        "requireOfflineFailOpenTests": { "const": true },
        "requireLiveIntegrationTests": { "const": true },
        "forbidPytestMarkSkip": { "const": true },
        "optionalDependencyGuard": { "const": "in-body-find-spec" },
        "forbidSecretLikeTestLiterals": { "const": true }
      }
    }
  }
}
